<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xmlns="http://www.semanticweb.org/ayca/ontologies/2026/3/university-kg#"
    xml:base="http://www.semanticweb.org/ayca/ontologies/2026/3/university-kg#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:ukg="http://www.semanticweb.org/ayca/ontologies/2026/3/university-kg#">

  <!-- ONTOLOGY DECLARATION -->
  <owl:Ontology rdf:about="http://www.semanticweb.org/ayca/ontologies/2026/3/university-kg">
    <rdfs:label xml:lang="en">University Knowledge Graph Ontology v2</rdfs:label>
    <rdfs:label xml:lang="tr">Üniversite Bilgi Grafiği Ontolojisi v2</rdfs:label>
    <rdfs:comment xml:lang="en">Extended ontology for Manisa Celal Bayar University Engineering Faculty. Models courses, academic staff, departments, and sub-fields. Version 2 adds MandatoryCourse/ElectiveCourse subclasses, ResearchAssistant class, SubField class, extended data properties, and real data from CSE, MEE, and IE departments.</rdfs:comment>
    <owl:versionInfo>2.0</owl:versionInfo>
  </owl:Ontology>

  <!-- ============================================================ -->
  <!-- OBJECT PROPERTIES                                            -->
  <!-- ============================================================ -->

  <owl:ObjectProperty rdf:about="ukg:belongsTo">
    <rdfs:domain rdf:resource="ukg:person"/>
    <rdfs:range rdf:resource="ukg:department"/>
    <rdfs:label xml:lang="en">belongs to</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a person to their department.</rdfs:comment>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="ukg:worksIn">
    <rdfs:domain rdf:resource="ukg:academicStaff"/>
    <rdfs:range rdf:resource="ukg:subField"/>
    <rdfs:label xml:lang="en">works in</rdfs:label>
    <rdfs:comment xml:lang="en">Relates an academic staff member to their sub-field (anabilim dalı).</rdfs:comment>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="ukg:hasSubField">
    <rdfs:domain rdf:resource="ukg:department"/>
    <rdfs:range rdf:resource="ukg:subField"/>
    <rdfs:label xml:lang="en">has sub-field</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a department to its academic sub-fields.</rdfs:comment>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="ukg:hasCourse">
    <rdfs:domain rdf:resource="ukg:department"/>
    <rdfs:range rdf:resource="ukg:course"/>
    <rdfs:label xml:lang="en">has course</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a department to the courses it offers.</rdfs:comment>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="ukg:offeredIn">
    <rdfs:domain rdf:resource="ukg:course"/>
    <rdfs:range rdf:resource="ukg:academicTerm"/>
    <rdfs:label xml:lang="en">offered in</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a course to the academic term it is offered in.</rdfs:comment>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="ukg:hasPrerequisite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:domain rdf:resource="ukg:course"/>
    <rdfs:range rdf:resource="ukg:course"/>
    <rdfs:label xml:lang="en">has prerequisite</rdfs:label>
    <rdfs:comment xml:lang="en">A course requires another course as prerequisite. Transitive.</rdfs:comment>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="ukg:isEnrolledIn">
    <rdfs:domain rdf:resource="ukg:student"/>
    <rdfs:range rdf:resource="ukg:course"/>
    <rdfs:label xml:lang="en">is enrolled in</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="ukg:teaches">
    <rdfs:domain rdf:resource="ukg:professor"/>
    <rdfs:range rdf:resource="ukg:course"/>
    <rdfs:label xml:lang="en">teaches</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="ukg:supervises">
    <rdfs:domain rdf:resource="ukg:professor"/>
    <rdfs:range rdf:resource="ukg:researchAssistant"/>
    <rdfs:label xml:lang="en">supervises</rdfs:label>
  </owl:ObjectProperty>

  <rdf:Description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointProperties"/>
    <owl:members rdf:parseType="Collection">
      <rdf:Description rdf:about="ukg:hasPrerequisite"/>
      <rdf:Description rdf:about="ukg:isEnrolledIn"/>
      <rdf:Description rdf:about="ukg:teaches"/>
    </owl:members>
  </rdf:Description>

  <!-- ============================================================ -->
  <!-- DATA PROPERTIES                                              -->
  <!-- ============================================================ -->

  <owl:DatatypeProperty rdf:about="ukg:courseCode">
    <rdfs:domain rdf:resource="ukg:course"/>
    <rdfs:range rdf:resource="xsd:string"/>
    <rdfs:label xml:lang="en">course code</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="ukg:courseName">
    <rdfs:domain rdf:resource="ukg:course"/>
    <rdfs:range rdf:resource="xsd:string"/>
    <rdfs:label xml:lang="en">course name</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="ukg:semester">
    <rdfs:domain rdf:resource="ukg:course"/>
    <rdfs:range rdf:resource="xsd:integer"/>
    <rdfs:label xml:lang="en">semester (1-8)</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="ukg:fullName">
    <rdfs:domain rdf:resource="ukg:person"/>
    <rdfs:range rdf:resource="xsd:string"/>
    <rdfs:label xml:lang="en">full name</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="ukg:title">
    <rdfs:domain rdf:resource="ukg:academicStaff"/>
    <rdfs:range rdf:resource="xsd:string"/>
    <rdfs:label xml:lang="en">academic title</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="ukg:email">
    <rdfs:domain rdf:resource="ukg:person"/>
    <rdfs:range rdf:resource="xsd:string"/>
    <rdfs:label xml:lang="en">email address</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="ukg:avesisURL">
    <rdfs:domain rdf:resource="ukg:academicStaff"/>
    <rdfs:range rdf:resource="xsd:anyURI"/>
    <rdfs:label xml:lang="en">AVESİS profile URL</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="ukg:studentID">
    <rdfs:domain rdf:resource="ukg:student"/>
    <rdfs:range rdf:resource="xsd:string"/>
    <rdfs:label xml:lang="en">student ID</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="ukg:GPA">
    <rdfs:domain rdf:resource="ukg:student"/>
    <rdfs:range rdf:resource="xsd:float"/>
    <rdfs:label xml:lang="en">GPA (0.0 - 4.0)</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="ukg:departmentName">
    <rdfs:domain rdf:resource="ukg:department"/>
    <rdfs:range rdf:resource="xsd:string"/>
    <rdfs:label xml:lang="en">department name</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="ukg:subFieldName">
    <rdfs:domain rdf:resource="ukg:subField"/>
    <rdfs:range rdf:resource="xsd:string"/>
    <rdfs:label xml:lang="en">sub-field name</rdfs:label>
  </owl:DatatypeProperty>

  <!-- ============================================================ -->
  <!-- CLASSES                                                      -->
  <!-- ============================================================ -->

  <owl:Class rdf:about="ukg:academicTerm">
    <rdfs:label xml:lang="en">Academic Term</rdfs:label>
    <rdfs:comment xml:lang="en">A semester or academic period (Fall, Spring).</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="ukg:department">
    <rdfs:label xml:lang="en">Department</rdfs:label>
    <rdfs:comment xml:lang="en">An engineering department at MCBU.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="ukg:subField">
    <rdfs:label xml:lang="en">Sub-Field (Anabilim Dalı)</rdfs:label>
    <rdfs:comment xml:lang="en">Academic sub-field within a department.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="ukg:course">
    <rdfs:label xml:lang="en">Course</rdfs:label>
    <rdfs:comment xml:lang="en">A course offered by a department.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="ukg:mandatoryCourse">
    <rdfs:subClassOf rdf:resource="ukg:course"/>
    <rdfs:label xml:lang="en">Mandatory Course</rdfs:label>
    <rdfs:comment xml:lang="en">A course that is compulsory for students (Zorunlu).</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="ukg:electiveCourse">
    <rdfs:subClassOf rdf:resource="ukg:course"/>
    <rdfs:label xml:lang="en">Elective Course</rdfs:label>
    <rdfs:comment xml:lang="en">A course that students can optionally select (Seçmeli).</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="ukg:person">
    <rdfs:label xml:lang="en">Person</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="ukg:academicStaff">
    <rdfs:subClassOf rdf:resource="ukg:person"/>
    <rdfs:label xml:lang="en">Academic Staff</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="ukg:professor">
    <rdfs:subClassOf rdf:resource="ukg:academicStaff"/>
    <rdfs:label xml:lang="en">Professor / Lecturer</rdfs:label>
    <rdfs:comment xml:lang="en">Full professor, associate professor, or assistant professor (Öğretim Üyesi).</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="ukg:researchAssistant">
    <rdfs:subClassOf rdf:resource="ukg:academicStaff"/>
    <rdfs:label xml:lang="en">Research Assistant (Araştırma Görevlisi)</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="ukg:student">
    <rdfs:subClassOf rdf:resource="ukg:person"/>
    <rdfs:label xml:lang="en">Student</rdfs:label>
  </owl:Class>

  <!-- Disjoint: professor and researchAssistant -->
  <rdf:Description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
    <owl:members rdf:parseType="Collection">
      <rdf:Description rdf:about="ukg:professor"/>
      <rdf:Description rdf:about="ukg:researchAssistant"/>
      <rdf:Description rdf:about="ukg:student"/>
    </owl:members>
  </rdf:Description>

  <!-- Disjoint: mandatoryCourse and electiveCourse -->
  <rdf:Description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
    <owl:members rdf:parseType="Collection">
      <rdf:Description rdf:about="ukg:mandatoryCourse"/>
      <rdf:Description rdf:about="ukg:electiveCourse"/>
    </owl:members>
  </rdf:Description>

  <!-- ============================================================ -->
  <!-- ACADEMIC TERMS                                               -->
  <!-- ============================================================ -->

  <ukg:academicTerm rdf:about="ukg:Fall">
    <rdfs:label xml:lang="en">Fall Semester</rdfs:label>
  </ukg:academicTerm>

  <ukg:academicTerm rdf:about="ukg:Spring">
    <rdfs:label xml:lang="en">Spring Semester</rdfs:label>
  </ukg:academicTerm>

  <!-- ============================================================ -->
  <!-- DEPARTMENTS                                                  -->
  <!-- ============================================================ -->

  <ukg:department rdf:about="ukg:CSE_Dept">
    <ukg:departmentName>Computer Engineering</ukg:departmentName>
    <rdfs:label xml:lang="en">Computer Engineering Department</rdfs:label>
    <rdfs:label xml:lang="tr">Bilgisayar Mühendisliği Bölümü</rdfs:label>
    <ukg:hasSubField rdf:resource="ukg:SF_Software"/>
    <ukg:hasSubField rdf:resource="ukg:SF_ComputerScience"/>
    <ukg:hasSubField rdf:resource="ukg:SF_Hardware"/>
  </ukg:department>

  <ukg:department rdf:about="ukg:MEE_Dept">
    <ukg:departmentName>Mechanical Engineering</ukg:departmentName>
    <rdfs:label xml:lang="en">Mechanical Engineering Department</rdfs:label>
    <rdfs:label xml:lang="tr">Makine Mühendisliği Bölümü</rdfs:label>
    <ukg:hasSubField rdf:resource="ukg:SF_Thermodynamics"/>
    <ukg:hasSubField rdf:resource="ukg:SF_ConstructionManufacturing"/>
    <ukg:hasSubField rdf:resource="ukg:SF_Mechanics"/>
    <ukg:hasSubField rdf:resource="ukg:SF_MachineTheory"/>
    <ukg:hasSubField rdf:resource="ukg:SF_Energy"/>
  </ukg:department>

  <ukg:department rdf:about="ukg:IE_Dept">
    <ukg:departmentName>Industrial Engineering</ukg:departmentName>
    <rdfs:label xml:lang="en">Industrial Engineering Department</rdfs:label>
    <rdfs:label xml:lang="tr">Endüstri Mühendisliği Bölümü</rdfs:label>
    <ukg:hasSubField rdf:resource="ukg:SF_OperationsResearch"/>
    <ukg:hasSubField rdf:resource="ukg:SF_IndustrialEngineering"/>
    <ukg:hasSubField rdf:resource="ukg:SF_AppliedStatistics"/>
  </ukg:department>

  <!-- ============================================================ -->
  <!-- SUB-FIELDS (Anabilim Dalları)                                -->
  <!-- ============================================================ -->

  <ukg:subField rdf:about="ukg:SF_Software">
    <ukg:subFieldName>Yazılım Anabilim Dalı</ukg:subFieldName>
    <rdfs:label xml:lang="tr">Yazılım Anabilim Dalı</rdfs:label>
  </ukg:subField>

  <ukg:subField rdf:about="ukg:SF_ComputerScience">
    <ukg:subFieldName>Bilgisayar Bilimleri Anabilim Dalı</ukg:subFieldName>
    <rdfs:label xml:lang="tr">Bilgisayar Bilimleri Anabilim Dalı</rdfs:label>
  </ukg:subField>

  <ukg:subField rdf:about="ukg:SF_Hardware">
    <ukg:subFieldName>Donanım Anabilim Dalı</ukg:subFieldName>
    <rdfs:label xml:lang="tr">Donanım Anabilim Dalı</rdfs:label>
  </ukg:subField>

  <ukg:subField rdf:about="ukg:SF_Thermodynamics">
    <ukg:subFieldName>Termodinamik Anabilim Dalı</ukg:subFieldName>
    <rdfs:label xml:lang="tr">Termodinamik Anabilim Dalı</rdfs:label>
  </ukg:subField>

  <ukg:subField rdf:about="ukg:SF_ConstructionManufacturing">
    <ukg:subFieldName>Konstrüksiyon ve İmalat Anabilim Dalı</ukg:subFieldName>
    <rdfs:label xml:lang="tr">Konstrüksiyon ve İmalat Anabilim Dalı</rdfs:label>
  </ukg:subField>

  <ukg:subField rdf:about="ukg:SF_Mechanics">
    <ukg:subFieldName>Mekanik Anabilim Dalı</ukg:subFieldName>
    <rdfs:label xml:lang="tr">Mekanik Anabilim Dalı</rdfs:label>
  </ukg:subField>

  <ukg:subField rdf:about="ukg:SF_MachineTheory">
    <ukg:subFieldName>Makine Teorisi ve Dinamiği Anabilim Dalı</ukg:subFieldName>
    <rdfs:label xml:lang="tr">Makine Teorisi ve Dinamiği Anabilim Dalı</rdfs:label>
  </ukg:subField>

  <ukg:subField rdf:about="ukg:SF_Energy">
    <ukg:subFieldName>Enerji Anabilim Dalı</ukg:subFieldName>
    <rdfs:label xml:lang="tr">Enerji Anabilim Dalı</rdfs:label>
  </ukg:subField>

  <ukg:subField rdf:about="ukg:SF_OperationsResearch">
    <ukg:subFieldName>Yöneylem Araştırması Anabilim Dalı</ukg:subFieldName>
    <rdfs:label xml:lang="tr">Yöneylem Araştırması Anabilim Dalı</rdfs:label>
  </ukg:subField>

  <ukg:subField rdf:about="ukg:SF_IndustrialEngineering">
    <ukg:subFieldName>Endüstri Mühendisliği Anabilim Dalı</ukg:subFieldName>
    <rdfs:label xml:lang="tr">Endüstri Mühendisliği Anabilim Dalı</rdfs:label>
  </ukg:subField>

  <ukg:subField rdf:about="ukg:SF_AppliedStatistics">
    <ukg:subFieldName>Uygulamalı İstatistik ve Olasılık Anabilim Dalı</ukg:subFieldName>
    <rdfs:label xml:lang="tr">Uygulamalı İstatistik ve Olasılık Anabilim Dalı</rdfs:label>
  </ukg:subField>


  <ukg:professor rdf:about="ukg:Tugba_Ozacar_Ozturk">
