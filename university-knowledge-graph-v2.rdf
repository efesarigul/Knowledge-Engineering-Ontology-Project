  <ukg:professor rdf:about="ukg:Volkan_Altintas">
    <ukg:fullName>Dr. Öğr. Üyesi Volkan ALTINTAŞ</ukg:fullName>
    <ukg:title>Dr. Öğr. Üyesi</ukg:title>
    <ukg:email>volkan.altintas@cbu.edu.tr</ukg:email>
    <ukg:avesisURL rdf:datatype="xsd:anyURI">https://avesis.mcbu.edu.tr/volkan.altintas</ukg:avesisURL>
    <rdfs:comment xml:lang="tr">Donanım Anabilim Dalı Başkanı</rdfs:comment>
    <ukg:belongsTo rdf:resource="ukg:CSE_Dept"/>
    <ukg:worksIn rdf:resource="ukg:SF_Hardware"/>
  </ukg:professor>

  <ukg:professor rdf:about="ukg:Gamze_Turkmen">
    <ukg:fullName>Dr. Öğr. Üyesi Gamze TÜRKMEN</ukg:fullName>
    <ukg:title>Dr. Öğr. Üyesi</ukg:title>
    <ukg:email>gamze.turkmen@cbu.edu.tr</ukg:email>
